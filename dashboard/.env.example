# Copy to .env.local (gitignored). Values below are the local-dev defaults and
# work as they stand — nothing here is a placeholder to fill in.
#
#     cp dashboard/.env.example dashboard/.env.local
#
# PRECEDENCE. Vite ranks the process environment ABOVE this file, and `make
# dash` exports the repo-root `.env` into the process. So `make dash` is driven
# by `<repo>/.env`; `pnpm --dir dashboard dev` is driven by this file. The two
# files ship identical values, and
# service/tests/config/test_env_example_contract.py fails if they drift.

# Base URL of the Keystone service API. No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Committed demo key sent as the X-Api-Key header. Admin scope — reviewer
# actions require org-wide scope (DESIGN §Dashboard ↔ API). This is the exact
# plaintext migration 0003_seed_api_clients seeded the hash of; it is the same
# value as DEMO_ADMIN_API_KEY in the repo-root .env.example. It shipped EMPTY,
# which authenticated the dashboard as nobody: `apiKey()` returned '' and the
# client raised ApiConfigError without ever sending a request.
VITE_API_KEY=keystone-demo-admin-8c25e0b71a94f36d

# Set to 1 to run against the in-browser MOCK service (src/mocks/**) instead of
# the real API. UNSET is the default and means the REAL client. `pnpm dev:mock`
# and the Playwright a11y run set this; `pnpm dev` and `pnpm build` do not.
VITE_USE_MOCK_API=
