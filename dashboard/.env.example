# Copy to .env.local (gitignored). Values below are the local-dev defaults.

# Base URL of the Keystone service API. No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Committed demo key sent as the X-Api-Key header. Admin scope — reviewer
# actions require org-wide scope (DESIGN §Dashboard ↔ API). Set in T-3.
VITE_API_KEY=

# Set to 1 to run against the in-browser MOCK service (src/mocks/**) instead of
# the real API. UNSET is the default and means the REAL client. `pnpm dev:mock`
# and the Playwright a11y run set this; `pnpm dev` and `pnpm build` do not.
VITE_USE_MOCK_API=
